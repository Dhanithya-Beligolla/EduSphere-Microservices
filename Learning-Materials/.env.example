# Application
APP_NAME=learning-materials-service
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=lms_learning_materials

# JWT — use a strong secret in production
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256

# Feature flags
ENABLE_AGENT_FEATURES=true

# Event publisher: noop | log
EVENT_PUBLISHER=log

# Server
HOST=0.0.0.0
PORT=4004
