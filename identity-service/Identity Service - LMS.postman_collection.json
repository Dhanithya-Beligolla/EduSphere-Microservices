    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json && json.data && json.data.accessToken) {",
              "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailOrUsername\": \"{{superadminLogin}}\",\n  \"password\": \"{{superadminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/{{apiPrefix}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{apiPrefix}}",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
