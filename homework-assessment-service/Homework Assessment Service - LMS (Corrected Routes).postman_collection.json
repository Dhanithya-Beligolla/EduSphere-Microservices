    {
      "name": "Login as Teacher (Identity Service)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Teacher login status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json && json.data) {",
              "    if (json.data.accessToken) {",
              "        pm.collectionVariables.set('teacherAccessToken', json.data.accessToken);",
              "    }",
              "    if (json.data.user && json.data.user.id) {",
              "        pm.collectionVariables.set('teacherId', json.data.user.id);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailOrUsername\": \"{{teacherLogin}}\",\n  \"password\": \"{{teacherPassword}}\"\n}"
        },
        "url": {
          "raw": "{{identityBaseUrl}}/{{identityApiPrefix}}/auth/login",
          "host": [
            "{{identityBaseUrl}}"
          ],
