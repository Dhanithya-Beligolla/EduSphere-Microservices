APP_NAME=homework-assessment-service
APP_ENV=development
API_V1_PREFIX=/api/v1
PORT=4002

# Local docker postgres
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=assessment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional external cloud postgres URL
DATABASE_URL=

# Identity service integration
IDENTITY_SERVICE_BASE_URL=http://host.docker.internal:4001
IDENTITY_VERIFY_ENDPOINT=/api/v1/auth/verify
IDENTITY_TIMEOUT_SECONDS=10

# Academic service integration (optional for now)
ACADEMIC_SERVICE_BASE_URL=http://host.docker.internal:4003
ACADEMIC_TIMEOUT_SECONDS=10
ACADEMIC_VALIDATION_ENABLED=false

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10