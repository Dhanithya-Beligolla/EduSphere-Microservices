{
  "info": {
    "name": "Academic LMS Backend",
    "description": "Postman collection for Academic LMS Backend service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Get Academic Years",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/academic-years"
      }
    },
    {
      "name": "Create Academic Year",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"2026\",\n  \"startDate\": \"2026-01-01\",\n  \"endDate\": \"2026-12-31\"\n}"
        },
        "url": "{{baseUrl}}/api/academic-years"
      }
    },
    {
      "name": "Get Grades",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/grades"
      }
    },
    {
      "name": "Get Subjects",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/subjects"
      }
    },
    {
      "name": "Get Enrollments",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/enrollments"
      }
    },
    {
      "name": "Get Teacher Assignments",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/teacher-assignments"
      }
    },
    {
      "name": "Get Timetable",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/timetable"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4003"
    }
  ]
}
