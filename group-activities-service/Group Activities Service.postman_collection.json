                "{{baseUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "groups"
              ],
              "query": [
                {
                  "key": "classId",
                  "value": "{{classId}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Add Member To Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
