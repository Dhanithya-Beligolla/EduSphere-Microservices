            "body": {
              "mode": "raw",
              "raw": "{\n  \"activityTitle\": \"Group STEM Prototype\",\n  \"description\": \"Build and present a simple STEM prototype\",\n  \"classId\": \"{{classId}}\",\n  \"subjectId\": \"{{subjectId}}\",\n  \"schoolId\": \"{{schoolId}}\",\n  \"academicYearId\": \"{{academicYearId}}\",\n  \"activityType\": \"PROJECT\",\n  \"groupMode\": \"MANUAL\",\n  \"peerEvaluationEnabled\": true,\n  \"markSplit\": {\n    \"groupScorePercent\": 70,\n    \"individualScorePercent\": 30\n  },\n  \"maxMarks\": 100,\n  \"dueAt\": \"2026-12-31T23:59:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiPrefix}}/group-activities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "group-activities"
              ]
            }
          },
          "response": []
